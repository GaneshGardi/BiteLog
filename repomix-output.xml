create or replace function public.get_group_weekly_history(
    p_group_id uuid,
    p_start_date date,
    p_end_date date,
    p_timezone text default 'Asia/Kolkata'
)
returns table (
    user_id uuid,
    username text,
    display_name text,
    log_date date,
    calories_consumed numeric,
    daily_calorie_goal numeric
)
language plpgsql
stable
security definer
set search_path = ''
as $$
begin
    -- Only authenticated members of this group may view its history.
    if auth.uid() is null
       or not public.is_group_member(p_group_id) then
        raise exception 'Not authorized to view this group'
            using errcode = '42501';
    end if;

    -- This endpoint is specifically for seven calendar days.
    if p_start_date is null
       or p_end_date is null
       or p_end_date - p_start_date <> 6 then
        raise exception 'Start and end dates must cover exactly seven days'
            using errcode = '22023';
    end if;

    -- Validate the timezone before using it to interpret goal dates.
    if not exists (
        select 1
        from pg_catalog.pg_timezone_names
        where name = p_timezone
    ) then
        raise exception 'Invalid timezone'
            using errcode = '22023';
    end if;

    return query
    select
        gm.user_id,
        p.username,
        p.display_name,
        day_series.day_timestamp::date as log_date,

        coalesce(
            (
                select sum(fl.calories)
                from public.food_logs as fl
                where fl.user_id = gm.user_id
                  and fl.log_date = day_series.day_timestamp::date
            ),
            0::numeric
        ) as calories_consumed,

        (
            select cg.daily_calories
            from public.calorie_goals as cg
            where cg.user_id = gm.user_id
              and cg.effective_at <
                  (
                      (day_series.day_timestamp::date + 1)::timestamp
                      at time zone p_timezone
                  )
            order by cg.effective_at desc, cg.created_at desc
            limit 1
        ) as daily_calorie_goal

    from public.group_members as gm
    join public.profiles as p
      on p.id = gm.user_id

    cross join generate_series(
        p_start_date::timestamp,
        p_end_date::timestamp,
        interval '1 day'
    ) as day_series(day_timestamp)

    where gm.group_id = p_group_id

    order by
        day_series.day_timestamp::date desc,
        lower(coalesce(p.display_name, p.username)),
        lower(p.username);
end;
$$;

revoke all
on function public.get_group_weekly_history(uuid, date, date, text)
from public;

grant execute
on function public.get_group_weekly_history(uuid, date, date, text)
to authenticated;
</file>

<file path="supabase/migrations/20261107193000_least_privilege_hardening.sql">
-- ============================================================
-- BiteLog: Least-privilege database hardening
-- ============================================================

-- 1. Remove broad direct permissions from client roles.
REVOKE ALL PRIVILEGES ON TABLE
    public.profiles,
    public.calorie_goals,
    public.food_logs,
    public.foods,
    public.groups,
    public.group_members,
    public.group_invitations
FROM PUBLIC, anon, authenticated;


-- 2. Grant only the operations required by BiteLog.

-- Profiles: read and update own profile.
GRANT SELECT, UPDATE
ON TABLE public.profiles
TO authenticated;

-- Calorie goals: read and insert historical goals.
GRANT SELECT, INSERT
ON TABLE public.calorie_goals
TO authenticated;

-- Food logs: read, insert and delete own entries.
GRANT SELECT, INSERT, DELETE
ON TABLE public.food_logs
TO authenticated;

-- Foods: required by the JWT-based log-food function.
GRANT SELECT
ON TABLE public.foods
TO authenticated;

-- Groups and memberships: read only.
GRANT SELECT
ON TABLE public.groups, public.group_members
TO authenticated;

-- Invitations: all operations use protected RPC functions.
-- No direct table permissions are granted.


-- 3. Remove existing client execution privileges
-- from every function in the public schema.
REVOKE EXECUTE
ON ALL FUNCTIONS IN SCHEMA public
FROM PUBLIC, anon, authenticated;


-- 4. Explicitly grant only the eight approved app RPCs.

GRANT EXECUTE ON FUNCTION public.create_group(text)
TO authenticated;

GRANT EXECUTE ON FUNCTION public.get_group_daily_progress(uuid, date)
TO authenticated;

GRANT EXECUTE ON FUNCTION
    public.get_group_weekly_history(uuid, date, date, text)
TO authenticated;

GRANT EXECUTE ON FUNCTION public.get_pending_group_invitations()
TO authenticated;

GRANT EXECUTE ON FUNCTION public.is_group_member(uuid)
TO authenticated;

GRANT EXECUTE ON FUNCTION
    public.respond_to_group_invitation(uuid, text)
TO authenticated;

GRANT EXECUTE ON FUNCTION public.search_users_for_invites(text)
TO authenticated;

GRANT EXECUTE ON FUNCTION
    public.send_group_invitation(uuid, text)
TO authenticated;


-- 5. Restrict default table permissions for future
-- objects created by postgres in the public schema.

ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
REVOKE ALL ON TABLES FROM anon, authenticated;

ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
REVOKE ALL ON SEQUENCES FROM anon, authenticated;


-- 6. Restrict default function permissions.
-- The PUBLIC revoke is global for future functions
-- created by postgres, across schemas.

ALTER DEFAULT PRIVILEGES FOR ROLE postgres
REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;

ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
REVOKE EXECUTE ON FUNCTIONS FROM anon, authenticated;


-- ============================================================
-- End of BiteLog permission hardening
-- ============================================================
</file>

