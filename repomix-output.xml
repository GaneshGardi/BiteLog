import { useEffect, useRef, useState } from "react";
import {
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { router, useLocalSearchParams } from "expo-router";
import { usePostHog } from "posthog-react-native";

import { supabase } from "../lib/supabase";
import { Sentry } from "../lib/sentry";
import { useAppDialog } from "../contexts/AppDialogContext";

const C = {
  background: "#101010",
  card: "#1A1A1A",
  input: "#141414",
  accent: "#B6F36B",
  text: "#FFFFFF",
  secondary: "#999999",
  muted: "#707070",
  border: "#303030",
};

type RecoveryStatus = "loading" | "ready" | "error";

type RecoveryAttempt = {
  code: string;
  promise: Promise<void>;
};

export default function ResetPasswordScreen() {
  const params = useLocalSearchParams<{ code?: string | string[] }>();
  const posthog = usePostHog();
  const { showDialog } = useAppDialog();

  const code = Array.isArray(params.code) ? params.code[0] : params.code;

  // Reuse the same exchange promise if React Strict Mode remounts the effect.
  const recoveryAttemptRef = useRef<RecoveryAttempt | null>(null);
  const missingCodeLoggedRef = useRef(false);

  const [recoveryStatus, setRecoveryStatus] =
    useState<RecoveryStatus>("loading");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [passwordVisible, setPasswordVisible] = useState(false);
  const [loading, setLoading] = useState(false);

  // Validate the recovery code and establish the Supabase session.
  useEffect(() => {
    let active = true;

    if (!code) {
      setRecoveryStatus("error");

      if (!missingCodeLoggedRef.current) {
        missingCodeLoggedRef.current = true;

        Sentry.logger.error(
          "Password recovery link is missing its verification code",
          {
            operation: "password_recovery",
            reason: "missing_code",
          },
        );

        posthog.capture("password_reset_link_failed", {
          reason: "missing_code",
        });
      }

      return () => {
        active = false;
      };
    }

    let recoveryPromise: Promise<void>;
    const existingAttempt = recoveryAttemptRef.current;

    if (existingAttempt?.code === code) {
      recoveryPromise = existingAttempt.promise;
    } else {
      recoveryPromise = (async () => {
        const { error } =
          await supabase.auth.exchangeCodeForSession(code);

        if (error) {
          throw error;
        }

        Sentry.logger.info("Password recovery link verified", {
          operation: "password_recovery",
        });

        posthog.capture("password_reset_link_verified");
      })().catch((error: unknown) => {
        Sentry.logger.error(
          "Password recovery link validation failed",
          {
            operation: "password_recovery",
            reason: "exchange_failed",
          },
        );

        Sentry.captureException(error);

        posthog.capture("password_reset_link_failed", {
          reason: "exchange_failed",
        });

        throw error;
      });

      recoveryAttemptRef.current = {
        code,
        promise: recoveryPromise,
      };
    }

    recoveryPromise
      .then(() => {
        if (active) {
          setRecoveryStatus("ready");
        }
      })
      .catch(() => {
        if (active) {
          setRecoveryStatus("error");
        }
      });

    return () => {
      active = false;
    };
  }, [code, posthog]);

  const handleContinue = async () => {
    try {
      const { error } = await supabase.auth.signOut();

      if (error) {
        throw error;
      }
    } catch (error) {
      Sentry.logger.error("Sign out after password reset failed", {
        operation: "password_reset_signout",
      });

      Sentry.captureException(error);
      posthog.capture("password_reset_signout_failed");
    } finally {
      router.replace("/login");
    }
  };

  const handleUpdatePassword = async () => {
    if (password.length < 8) {
      showDialog(
        "Password too short",
        "Your new password must contain at least 8 characters.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (password !== confirmPassword) {
      showDialog(
        "Passwords don't match",
        "Please enter the same password in both fields.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (loading) return;

    setLoading(true);

    try {
      const { error } = await supabase.auth.updateUser({
        password,
      });

      if (error) {
        const normalizedMessage = error.message.toLowerCase();

        const isSamePassword =
          error.code === "same_password" ||
          normalizedMessage.includes("same password") ||
          normalizedMessage.includes("same as the current password") ||
          normalizedMessage.includes("different from the old password") ||
          normalizedMessage.includes("different from the current password");

        if (isSamePassword) {
          Sentry.logger.info(
            "Password reset rejected because the password was reused",
            {
              operation: "password_update",
              reason: "same_password",
            },
          );

          posthog.capture("password_reset_same_password_attempted");

          setPassword("");
          setConfirmPassword("");

          showDialog(
            "Choose a different password",
            "This is already your current password. Please enter a new password that you haven't used before.",
            [{ text: "OK" }],
            { type: "warning" },
          );

          return;
        }

        Sentry.logger.error("Password update failed", {
          operation: "password_update",
          reason: "auth_error",
        });

        Sentry.captureException(error);

        posthog.capture("password_reset_failed", {
          reason: "auth_error",
        });

        showDialog(
          "Update failed",
          "We couldn't update your password. Please try again.",
          [{ text: "OK" }],
          { type: "error" },
        );

        return;
      }

      Sentry.logger.info("Password updated successfully", {
        operation: "password_update",
      });

      posthog.capture("password_reset_completed");

      setPassword("");
      setConfirmPassword("");

      showDialog(
        "Password updated",
        "Your password has been changed successfully. Please log in with your new password.",
        [
          {
            text: "Continue",
            onPress: handleContinue,
          },
        ],
        {
          type: "success",
          cancelable: false,
        },
      );
    } catch (error) {
      Sentry.logger.error("Unexpected password update error", {
        operation: "password_update",
        reason: "unexpected_error",
      });

      Sentry.captureException(error);

      posthog.capture("password_reset_failed", {
        reason: "unexpected_error",
      });

      showDialog(
        "Something went wrong",
        "We couldn't update your password. Please try again.",
        [{ text: "OK" }],
        { type: "error" },
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.container}
      behavior={Platform.OS === "ios" ? "padding" : "height"}
    >
      <ScrollView
        contentContainerStyle={styles.content}
        keyboardShouldPersistTaps="handled"
        keyboardDismissMode={Platform.OS === "ios" ? "interactive" : "on-drag"}
        showsVerticalScrollIndicator={false}
      >
        <Pressable
          style={styles.backButton}
          onPress={() => router.replace("/login")}
          hitSlop={10}
        >
          <Ionicons name="arrow-back" size={21} color={C.text} />
          <Text style={styles.backText}>Back to login</Text>
        </Pressable>

        <View style={styles.iconContainer}>
          <Ionicons
            name="lock-closed-outline"
            size={32}
            color={C.accent}
          />
        </View>

        <Text style={styles.eyebrow}>ACCOUNT SECURITY</Text>

        <Text style={styles.title}>
          Create a new{"\n"}password.
        </Text>

        {recoveryStatus === "loading" ? (
          <View style={styles.messageCard}>
            <ActivityIndicator size="large" color={C.accent} />
            <Text style={styles.messageText}>
              Verifying your password reset link…
            </Text>
          </View>
        ) : recoveryStatus === "error" ? (
          <View style={styles.messageCard}>
            <Ionicons
              name="alert-circle-outline"
              size={36}
              color="#FF8585"
            />

            <Text style={styles.messageTitle}>
              Link invalid or expired
            </Text>

            <Text style={styles.messageText}>
              This password reset link may have expired or already been used.
              Please request a new one.
            </Text>

            <Pressable
              style={styles.button}
              onPress={() => router.replace("/forgot-password")}
            >
              <Text style={styles.buttonText}>
                Request another link
              </Text>
            </Pressable>
          </View>
        ) : (
          <>
            <Text style={styles.subtitle}>
              Choose a strong password with at least 8 characters.
            </Text>

            <View style={styles.form}>
              <Text style={styles.label}>New password</Text>

              <View style={styles.inputContainer}>
                <Ionicons
                  name="lock-closed-outline"
                  size={19}
                  color={C.muted}
                />

                <TextInput
                  style={styles.input}
                  placeholder="Enter new password"
                  placeholderTextColor={C.muted}
                  value={password}
                  onChangeText={setPassword}
                  secureTextEntry={!passwordVisible}
                  autoCapitalize="none"
                  autoCorrect={false}
                  textContentType="newPassword"
                  autoComplete="new-password"
                  editable={!loading}
                  returnKeyType="next"
                />

                <Pressable
                  onPress={() =>
                    setPasswordVisible((visible) => !visible)
                  }
                  hitSlop={10}
                  disabled={loading}
                >
                  <Ionicons
                    name={
                      passwordVisible
                        ? "eye-off-outline"
                        : "eye-outline"
                    }
                    size={19}
                    color={C.muted}
                  />
                </Pressable>
              </View>

              <Text style={styles.label}>
                Confirm new password
              </Text>

              <View style={styles.inputContainer}>
                <Ionicons
                  name="lock-closed-outline"
                  size={19}
                  color={C.muted}
                />

                <TextInput
                  style={styles.input}
                  placeholder="Re-enter new password"
                  placeholderTextColor={C.muted}
                  value={confirmPassword}
                  onChangeText={setConfirmPassword}
                  secureTextEntry={!passwordVisible}
                  autoCapitalize="none"
                  autoCorrect={false}
                  textContentType="newPassword"
                  autoComplete="new-password"
                  editable={!loading}
                  returnKeyType="done"
                  onSubmitEditing={handleUpdatePassword}
                />
              </View>

              <Pressable
                style={({ pressed }) => [
                  styles.button,
                  pressed && styles.buttonPressed,
                  loading && styles.buttonDisabled,
                ]}
                onPress={handleUpdatePassword}
                disabled={loading}
              >
                {loading ? (
                  <ActivityIndicator color={C.background} />
                ) : (
                  <>
                    <Text style={styles.buttonText}>
                      Update password
                    </Text>

                    <Ionicons
                      name="arrow-forward"
                      size={19}
                      color={C.background}
                    />
                  </>
                )}
              </Pressable>
            </View>
          </>
        )}
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

