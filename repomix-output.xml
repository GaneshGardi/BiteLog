import { useCallback, useEffect, useState } from "react";
import {
  ActivityIndicator,
  Pressable,
  RefreshControl,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import {
  Stack,
  useLocalSearchParams,
  useRouter,
  useFocusEffect,
} from "expo-router";
import { Ionicons } from "@expo/vector-icons";
import { SafeAreaView } from "react-native-safe-area-context";

import AppModal from "../../components/AppModal";
import { useAppDialog } from "../../contexts/AppDialogContext";
import { supabase } from "../../lib/supabase";
import { usePostHog } from "posthog-react-native";
import { Sentry } from "../../lib/sentry";

type GroupInfo = {
  id: string;
  name: string;
  created_by: string;
  created_at: string;
};

type Member = {
  user_id: string;
  role: "owner" | "member";
  joined_at: string;
};

type Profile = {
  id: string;
  username: string;
  display_name: string | null;
};

type SearchUser = {
  user_id: string;
  username: string;
  display_name: string | null;
};

type DailyProgress = {
  user_id: string;
  username: string;
  display_name: string | null;
  calories_consumed: number | string;
  daily_calorie_goal: number | string | null;
};

export default function GroupDetailsScreen() {
  const { id } = useLocalSearchParams<{ id: string | string[] }>();
  const router = useRouter();
  const posthog = usePostHog();
  const { showDialog } = useAppDialog();

  const groupId = Array.isArray(id) ? id[0] : id;

  const [group, setGroup] = useState<GroupInfo | null>(null);
  const [members, setMembers] = useState<Member[]>([]);
  const [profiles, setProfiles] = useState<Record<string, Profile>>({});
  const [dailyProgress, setDailyProgress] = useState<DailyProgress[]>([]);

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [progressError, setProgressError] = useState("");

  const [inviteVisible, setInviteVisible] = useState(false);
  const [selectedUser, setSelectedUser] = useState<SearchUser | null>(null);
  const [username, setUsername] = useState("");
  const [searchResults, setSearchResults] = useState<SearchUser[]>([]);
  const [searching, setSearching] = useState(false);
  const [sending, setSending] = useState(false);
  const [searchError, setSearchError] = useState("");

  const loadGroup = useCallback(async () => {
    if (!groupId) {
      setLoading(false);
      setRefreshing(false);
      return;
    }

    try {
      const { data: groupData, error: groupError } = await supabase
        .from("groups")
        .select("id, name, created_by, created_at")
        .eq("id", groupId)
        .single();

      if (groupError) throw groupError;

      setGroup(groupData);

      const { data: memberData, error: memberError } = await supabase
        .from("group_members")
        .select("user_id, role, joined_at")
        .eq("group_id", groupId)
        .order("joined_at", { ascending: true });

      if (memberError) throw memberError;

      const memberList = (memberData ?? []) as Member[];
      setMembers(memberList);

      // Use the device's local calendar date, not UTC.
      const now = new Date();
      const localDate = [
        now.getFullYear(),
        String(now.getMonth() + 1).padStart(2, "0"),
        String(now.getDate()).padStart(2, "0"),
      ].join("-");

      try {
        const { data: progressData, error: progressFetchError } =
          await supabase.rpc("get_group_daily_progress", {
            p_group_id: groupId,
            p_log_date: localDate,
          });

        if (progressFetchError) throw progressFetchError;

        setDailyProgress((progressData ?? []) as DailyProgress[]);
        setProgressError("");
      } catch (error) {
        Sentry.logger.error("Group calorie progress failed to load", {
          operation: "load_group_daily_progress",
        });
        Sentry.captureException(error);
        posthog.capture("group_daily_progress_load_failed");

        setDailyProgress([]);
        setProgressError(
          "Could not load calorie progress. Pull down to retry.",
        );
      }

      const userIds = [...new Set(memberList.map((member) => member.user_id))];

      if (userIds.length > 0) {
        const { data: profileData, error: profileError } = await supabase
          .from("profiles")
          .select("id, username, display_name")
          .in("id", userIds);

        if (profileError) throw profileError;

        const profileMap: Record<string, Profile> = {};
        (profileData ?? []).forEach((profile) => {
          profileMap[profile.id] = profile as Profile;
        });

        setProfiles(profileMap);
      } else {
        setProfiles({});
      }
    } catch (error) {
      Sentry.logger.error("Group details failed to load", {
        operation: "load_group_details",
      });
      Sentry.captureException(error);
      posthog.capture("group_details_load_failed");

      showDialog(
        "Unable to load group",
        error instanceof Error ? error.message : "Please try again.",
        [{ text: "OK" }],
        { type: "error" },
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, [groupId, posthog, showDialog]);

  useFocusEffect(
    useCallback(() => {
      posthog.capture("group_viewed");
      setLoading(true);
      void loadGroup();
    }, [loadGroup, posthog]),
  );

  const refresh = () => {
    setRefreshing(true);
    void loadGroup();
  };

  // Search while typing, with a short delay to avoid querying on every keystroke.
  useEffect(() => {
    const searchTerm = username.trim();
    const normalizedSearchTerm = searchTerm.replace(/^@/, "").toLowerCase();

    setSearchError("");

    // Preserve the selected friend in the results.
    if (
      selectedUser &&
      selectedUser.username.toLowerCase() === normalizedSearchTerm
    ) {
      setSearchResults([selectedUser]);
      setSearching(false);
      return;
    }

    setSearchResults([]);

    if (searchTerm.length < 2 || !inviteVisible) {
      setSearching(false);
      return;
    }

    let cancelled = false;
    setSearching(true);

    const timeout = setTimeout(async () => {
      try {
        const { data, error } = await supabase.rpc("search_users_for_invites", {
          p_search: searchTerm,
        });

        if (error) throw error;

        if (!cancelled) {
          setSearchResults((data ?? []) as SearchUser[]);
        }
      } catch (error) {
        if (!cancelled) {
          Sentry.logger.error("Username search failed", {
            operation: "search_users_for_invites",
          });
          Sentry.captureException(error);
          posthog.capture("group_invitee_search_failed");

          setSearchError(
            "Search is temporarily unavailable. You can still enter a username directly.",
          );
        }
      } finally {
        if (!cancelled) {
          setSearching(false);
        }
      }
    }, 350);

    return () => {
      cancelled = true;
      clearTimeout(timeout);
    };
  }, [username, inviteVisible, selectedUser, posthog]);

  const closeInviteModal = () => {
    if (sending) return;

    setInviteVisible(false);
    setUsername("");
    setSelectedUser(null);
    setSearchResults([]);
    setSearchError("");
  };

  const sendInvitation = async () => {
    const targetUsername = (selectedUser?.username ?? username.trim()).replace(
      /^@/,
      "",
    );

    if (!targetUsername) {
      showDialog(
        "Username required",
        "Enter the username of the person you want to invite.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (!groupId) {
      showDialog(
        "Group unavailable",
        "Reopen the group and try again.",
        [{ text: "OK" }],
        { type: "error" },
      );
      return;
    }

    setSending(true);

    try {
      const { error } = await supabase.rpc("send_group_invitation", {
        p_group_id: groupId,
        p_username: targetUsername,
      });

      if (error) throw error;

      Sentry.logger.info("Group invitation sent", {
        operation: "send_group_invitation",
      });
      posthog.capture("group_invitation_sent");

      setInviteVisible(false);
      setUsername("");
      setSelectedUser(null);
      setSearchResults([]);
      setSearchError("");

      showDialog(
        "Invitation sent!",
        `Your invitation to @${targetUsername} has been sent.`,
        [{ text: "Done" }],
        { type: "success" },
      );
    } catch (error) {
      Sentry.logger.error("Group invitation failed", {
        operation: "send_group_invitation",
      });
      Sentry.captureException(error);
      posthog.capture("group_invitation_failed", {
        failure_stage: "send_invitation",
      });

      const message =
        error instanceof Error ? error.message : "Please try again.";

      showDialog(
        "Could not send invitation",
        message,
        [{ text: "OK" }],
        { type: "error" },
      );
    } finally {
      setSending(false);
    }
  };

  const openMemberHistory = (memberId: string) => {
    if (!groupId || !memberId) return;

    router.push({
      pathname: "/group/[id]/history/[memberId]",
      params: {
        id: groupId,
        memberId,
      },
    });
  };

  return (
    <SafeAreaView style={styles.container} edges={["bottom"]}>
      <Stack.Screen
        options={{
          title: group?.name ?? "Group details",
          headerStyle: { backgroundColor: "#101010" },
          headerTintColor: "#FFFFFF",
          headerTitleStyle: { fontWeight: "700" },
          headerShadowVisible: false,
          contentStyle: { backgroundColor: "#101010" },
        }}
      />

      {loading ? (
        <View style={styles.center}>
          <ActivityIndicator size="large" color="#B6F36B" />
          <Text style={styles.muted}>Loading group...</Text>
        </View>
      ) : !group ? (
        <View style={styles.center}>
          <View style={styles.emptyIcon}>
            <Ionicons name="people-outline" size={30} color="#B6F36B" />
          </View>

          <Text style={styles.heading}>Group not found</Text>
          <Text style={styles.muted}>
            You may not have access to this group.
          </Text>

          <Pressable style={styles.primaryButton} onPress={() => router.back()}>
            <Text style={styles.primaryButtonText}>Go back</Text>
          </Pressable>
        </View>
      ) : (
        <ScrollView
          contentContainerStyle={styles.content}
          showsVerticalScrollIndicator={false}
          keyboardShouldPersistTaps="handled"
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              onRefresh={refresh}
              tintColor="#B6F36B"
              colors={["#B6F36B"]}
              progressBackgroundColor="#1A1A1A"
            />
          }
        >
          {/* Group overview */}
          <View style={styles.hero}>
            <View style={styles.groupIcon}>
              <Ionicons name="people" size={32} color="#B6F36B" />
            </View>

            <Text style={styles.groupName}>{group.name}</Text>

            <View style={styles.memberCountBadge}>
              <Ionicons name="people-outline" size={14} color="#B6F36B" />
              <Text style={styles.memberCountText}>
                {members.length} {members.length === 1 ? "member" : "members"}
              </Text>
            </View>

            <Text style={styles.heroDescription}>
              Track your progress together.
            </Text>
          </View>

          {/* Members heading */}
          <View style={styles.sectionHeader}>
            <View>
              <Text style={styles.sectionTitle}>Group members</Text>
              <Text style={styles.sectionSubtitle}>
                Today's calorie progress
              </Text>
            </View>

            <View style={styles.countBadge}>
              <Text style={styles.countText}>{members.length}</Text>
            </View>
          </View>

          {!!progressError && (
            <View style={styles.errorBanner}>
              <Ionicons name="alert-circle-outline" size={18} color="#FF8A8A" />
              <Text style={styles.errorBannerText}>{progressError}</Text>
            </View>
          )}

          {/* Member cards */}
          {members.length === 0 ? (
            <View style={styles.emptyCard}>
              <Ionicons name="person-add-outline" size={30} color="#777777" />
              <Text style={styles.emptyTitle}>No members yet</Text>
              <Text style={styles.emptyDescription}>
                Invite friends to start tracking progress together.
              </Text>
            </View>
          ) : (
            members.map((member) => {
              const profile = profiles[member.user_id];
              const progress = dailyProgress.find(
                (item) => item.user_id === member.user_id,
              );

              const memberUsername =
                progress?.username || profile?.username || "";

              const displayName =
                progress?.display_name?.trim() ||
                profile?.display_name?.trim() ||
                memberUsername ||
                "Member";

              const consumed = Number(progress?.calories_consumed) || 0;
              const goal =
                progress?.daily_calorie_goal == null
                  ? null
                  : Number(progress.daily_calorie_goal);

              const percentage =
                goal !== null && goal > 0
                  ? Math.round((consumed / goal) * 100)
                  : null;

              const progressWidth = `${Math.min(
                Math.max(percentage ?? 0, 0),
                100,
              )}%` as `${number}%`;

              return (
                <Pressable
                  key={member.user_id}
                  style={({ pressed }) => [
                    styles.memberCard,
                    pressed && styles.memberCardPressed,
                  ]}
                  accessibilityRole="button"
                  accessibilityLabel={`View weekly history for ${displayName}`}
                  onPress={() => openMemberHistory(member.user_id)}
                >
                  <View style={styles.memberTopRow}>
                    <View style={styles.avatar}>
                      <Text style={styles.avatarText}>
                        {displayName.charAt(0).toUpperCase()}
                      </Text>
                    </View>

                    <View style={styles.memberInfo}>
                      <Text style={styles.memberName}>{displayName}</Text>
                      <Text style={styles.usernameLabel}>
                        {memberUsername
                          ? `@${memberUsername}`
                          : "Username unavailable"}
                      </Text>
                    </View>

                    <View
                      style={[
                        styles.roleBadge,
                        member.role === "owner" && styles.ownerBadge,
                      ]}
                    >
                      <Ionicons
                        name={
                          member.role === "owner"
                            ? "shield-checkmark"
                            : "person-outline"
                        }
                        size={11}
                        color={member.role === "owner" ? "#B6F36B" : "#999999"}
                      />
                      <Text
                        style={[
                          styles.roleText,
                          member.role === "owner" && styles.ownerText,
                        ]}
                      >
                        {member.role === "owner" ? "Owner" : "Member"}
                      </Text>
                    </View>
                  </View>

                  <View style={styles.memberProgress}>
                    <View style={styles.calorieNumbers}>
                      <View>
                        <Text style={styles.caloriesConsumed}>
                          {Math.round(consumed).toLocaleString()}
                          <Text style={styles.kcalLabel}> kcal</Text>
                        </Text>
                        <Text style={styles.calorieGoal}>
                          {goal !== null && goal > 0
                            ? `of ${Math.round(goal).toLocaleString()} kcal goal`
                            : "Daily goal not set"}
                        </Text>
                      </View>

                      {percentage !== null && (
                        <View style={styles.percentageBadge}>
                          <Text style={styles.progressPercentage}>
                            {percentage}%
                          </Text>
                        </View>
                      )}
                    </View>

                    {goal !== null && goal > 0 && (
                      <View style={styles.progressTrack}>
                        <View
                          style={[
                            styles.progressFill,
                            { width: progressWidth },
                          ]}
                        />
                      </View>
                    )}

                    {percentage !== null && percentage >= 100 && (
                      <View style={styles.goalReachedRow}>
                        <Ionicons
                          name="checkmark-circle"
                          size={14}
                          color="#B6F36B"
                        />
                        <Text style={styles.goalReached}>
                          Daily goal reached
                        </Text>
                      </View>
                    )}
                  </View>

                  <View style={styles.historyHintRow}>
                    <Text style={styles.historyHint}>View weekly history</Text>
                    <Ionicons
                      name="chevron-forward"
                      size={16}
                      color="#B6F36B"
                    />
                  </View>
                </Pressable>
              );
            })
          )}

          {/* Invite friends */}
          <Pressable
            style={({ pressed }) => [
              styles.inviteButton,
              pressed && styles.inviteButtonPressed,
            ]}
            onPress={() => setInviteVisible(true)}
          >
            <Ionicons name="person-add-outline" size={19} color="#101010" />
            <Text style={styles.inviteButtonText}>Invite friends</Text>
          </Pressable>

          <View style={styles.privacyNote}>
            <Ionicons name="lock-closed-outline" size={15} color="#777777" />
            <Text style={styles.footer}>
              Only daily calorie progress is shared. Individual food logs remain
              private.
            </Text>
          </View>
        </ScrollView>
      )}

      {/* Invite friends modal */}
      <AppModal
        visible={inviteVisible}
        onClose={closeInviteModal}
        title="Invite a friend"
        subtitle="Find people by username or display name and invite them to your group."
        presentation="bottom"
        closeOnBackdropPress={!sending}
        loading={sending}
        footer={
          <View style={styles.inviteModalFooter}>
            <Pressable
              style={[styles.sendButton, sending && styles.disabledButton]}
              onPress={() => void sendInvitation()}
              disabled={sending}
            >
              {sending ? (
                <ActivityIndicator color="#101010" />
              ) : (
                <>
                  <Ionicons name="send-outline" size={17} color="#101010" />
                  <Text style={styles.sendButtonText}>Send invitation</Text>
                </>
              )}
            </Pressable>

            <Pressable
              style={styles.cancelButton}
              onPress={closeInviteModal}
              disabled={sending}
            >
              <Text style={styles.cancelButtonText}>Cancel</Text>
            </Pressable>
          </View>
        }
      >
        <View style={styles.modalIcon}>
          <Ionicons name="person-add" size={23} color="#B6F36B" />
        </View>

        <Text style={styles.inputLabel}>USERNAME</Text>

        <View style={styles.inputContainer}>
          <Ionicons name="search-outline" size={19} color="#777777" />

          <TextInput
            style={styles.input}
            placeholder="Search username..."
            placeholderTextColor="#777777"
            value={username}
            onChangeText={(text) => {
              setUsername(text);
              setSelectedUser(null);
            }}
            autoCapitalize="none"
            autoCorrect={false}
            returnKeyType="send"
            onSubmitEditing={() => void sendInvitation()}
            editable={!sending}
            autoFocus
          />

          {searching && (
            <ActivityIndicator size="small" color="#B6F36B" />
          )}
        </View>

        {!!searchError && (
          <Text style={styles.errorText}>{searchError}</Text>
        )}

        {username.trim().length >= 2 &&
          !searching &&
          !searchError &&
          searchResults.length === 0 && (
            <Text style={styles.searchStatusText}>
              No matches. You can still invite by exact username.
            </Text>
          )}

        {searchResults.length > 0 && (
          <View style={styles.resultsContainer}>
            <Text style={styles.resultsTitle}>MATCHING USERS</Text>

            {searchResults.map((user) => {
              const displayName =
                user.display_name?.trim() || user.username;
              const isSelected = selectedUser?.user_id === user.user_id;

              return (
                <Pressable
                  key={user.user_id}
                  style={({ pressed }) => [
                    styles.resultRow,
                    isSelected && styles.resultRowSelected,
                    pressed && styles.resultRowPressed,
                  ]}
                  onPress={() => {
                    setSelectedUser(user);
                    setUsername(user.username);
                  }}
                  disabled={sending}
                  accessibilityRole="button"
                  accessibilityState={{ selected: isSelected }}
                >
                  <View
                    style={[
                      styles.resultAvatar,
                      isSelected && styles.resultAvatarSelected,
                    ]}
                  >
                    <Text style={styles.resultAvatarText}>
                      {displayName.charAt(0).toUpperCase()}
                    </Text>
                  </View>

                  <View style={styles.resultInfo}>
                    <Text style={styles.resultName}>{displayName}</Text>
                    <Text style={styles.usernameLabel}>
                      @{user.username}
                    </Text>
                  </View>

                  <View style={styles.selectionIndicator}>
                    <Ionicons
                      name={
                        isSelected
                          ? "checkmark-circle"
                          : "ellipse-outline"
                      }
                      size={20}
                      color={isSelected ? "#B6F36B" : "#666666"}
                    />
                    <Text
                      style={[
                        styles.selectLabel,
                        isSelected && styles.selectedLabel,
                      ]}
                    >
                      {isSelected ? "Selected" : "Select"}
                    </Text>
                  </View>
                </Pressable>
              );
            })}
          </View>
        )}
      </AppModal>
    </SafeAreaView>
  );
}

