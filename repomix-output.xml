import { useState } from "react";
import {
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { router } from "expo-router";
import { usePostHog } from "posthog-react-native";

import { supabase } from "../lib/supabase";
import { Sentry } from "../lib/sentry";
import { useAppDialog } from "../contexts/AppDialogContext";

const C = {
  background: "#101010",
  card: "#1A1A1A",
  input: "#141414",
  accent: "#B6F36B",
  text: "#FFFFFF",
  secondary: "#999999",
  muted: "#707070",
  border: "#303030",
};

export default function CalorieGoalScreen() {
  const posthog = usePostHog();
  const { showDialog } = useAppDialog();

  const [calories, setCalories] = useState("");
  const [saving, setSaving] = useState(false);

  const handleSave = async () => {
    if (saving) return;

    const cleanCalories = calories.trim();
    const dailyCalories = Number(cleanCalories);

    if (
      !cleanCalories ||
      !Number.isFinite(dailyCalories) ||
      dailyCalories <= 0
    ) {
      showDialog(
        "Invalid calorie goal",
        "Please enter a valid daily calorie goal greater than zero.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    setSaving(true);

    try {
      const {
        data: { user },
        error: userError,
      } = await supabase.auth.getUser();

      if (userError || !user) {
        Sentry.logger.warn("Calorie goal save failed: no active session", {
          operation: "save_calorie_goal",
        });

        posthog.capture("calorie_goal_update_failed", {
          failure_stage: "session_lookup",
        });

        showDialog(
          "Session expired",
          "Please log in again to save your calorie goal.",
          [
            {
              text: "Go to login",
              onPress: () => router.replace("/login"),
            },
          ],
          { type: "warning", cancelable: false },
        );
        return;
      }

      const { error } = await supabase.from("calorie_goals").insert({
        user_id: user.id,
        daily_calories: dailyCalories,
        effective_at: new Date().toISOString(),
      });

      if (error) {
        Sentry.logger.error("Calorie goal save failed", {
          operation: "save_calorie_goal",
          reason: "database_insert",
        });

        Sentry.captureException(error);

        posthog.capture("calorie_goal_update_failed", {
          failure_stage: "database_insert",
        });

        showDialog(
          "Could not save goal",
          "We couldn't save your calorie goal. Please try again.",
          [{ text: "OK" }],
          { type: "error" },
        );
        return;
      }

      Sentry.logger.info("Calorie goal saved", {
        operation: "save_calorie_goal",
      });

      posthog.capture("calorie_goal_updated", {
        source: "initial_setup",
      });

      router.replace("/");
    } catch (error) {
      Sentry.logger.error("Unexpected calorie goal save error", {
        operation: "save_calorie_goal",
        reason: "unexpected_error",
      });

      Sentry.captureException(error);

      posthog.capture("calorie_goal_update_failed", {
        failure_stage: "unexpected_error",
      });

      showDialog(
        "Could not save goal",
        "Something went wrong while saving your calorie goal. Please try again.",
        [{ text: "OK" }],
        { type: "error" },
      );
    } finally {
      setSaving(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.container}
      behavior={Platform.OS === "ios" ? "padding" : "height"}
      keyboardVerticalOffset={0}
    >
      <ScrollView
        contentContainerStyle={styles.content}
        keyboardShouldPersistTaps="handled"
        keyboardDismissMode={Platform.OS === "ios" ? "interactive" : "on-drag"}
        showsVerticalScrollIndicator={false}
      >
        {/* Brand */}
        <View style={styles.brand}>
          <View style={styles.brandIcon}>
            <Ionicons name="nutrition" size={25} color={C.background} />
          </View>

          <Text style={styles.brandName}>
            Bite<Text style={styles.brandAccent}>Log</Text>
          </Text>
        </View>

        {/* Heading */}
        <View style={styles.header}>
          <Text style={styles.eyebrow}>ONE LAST STEP</Text>

          <Text style={styles.title}>
            Set your daily{"\n"}calorie goal.
          </Text>

          <Text style={styles.subtitle}>
            Choose your daily calorie target. We'll use it to help you monitor
            your progress every day.
          </Text>
        </View>

        {/* Calorie input card */}
        <View style={styles.goalCard}>
          <View style={styles.calorieIcon}>
            <Ionicons name="flame" size={25} color={C.accent} />
          </View>

          <Text style={styles.cardLabel}>YOUR DAILY TARGET</Text>

          <View style={styles.inputWrapper}>
            <TextInput
              style={styles.input}
              placeholder="2200"
              placeholderTextColor="#555555"
              keyboardType="numeric"
              value={calories}
              onChangeText={setCalories}
              editable={!saving}
              maxLength={5}
              returnKeyType="done"
              onSubmitEditing={handleSave}
              accessibilityLabel="Daily calorie goal in kilocalories"
            />

            <Text style={styles.unit}>kcal</Text>
          </View>

          <View style={styles.divider} />

          <View style={styles.dailyInfo}>
            <Ionicons name="calendar-outline" size={16} color={C.secondary} />

            <Text style={styles.dailyInfoText}>
              Your target will be tracked daily.
            </Text>
          </View>
        </View>

        {/* Information */}
        <View style={styles.infoCard}>
          <Ionicons
            name="information-circle-outline"
            size={19}
            color={C.accent}
          />

          <Text style={styles.infoText}>
            You can update your calorie goal later as your fitness goals and
            progress change.
          </Text>
        </View>

        {/* Save button */}
        <Pressable
          style={({ pressed }) => [
            styles.button,
            pressed && styles.buttonPressed,
            saving && styles.buttonDisabled,
          ]}
          onPress={handleSave}
          disabled={saving}
        >
          {saving ? (
            <ActivityIndicator color={C.background} />
          ) : (
            <>
              <Text style={styles.buttonText}>Save & Continue</Text>

              <Ionicons name="arrow-forward" size={19} color={C.background} />
            </>
          )}
        </Pressable>

        {/* Footer */}
        <View style={styles.footer}>
          <Ionicons name="shield-checkmark-outline" size={14} color={C.muted} />

          <Text style={styles.footerText}>
            Your goals. Your progress. Your journey.
          </Text>
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
  container: {
