import { useCallback, useState } from "react";
import {
  ActivityIndicator,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { useFocusEffect } from "expo-router";
import { supabase } from "../lib/supabase";

type WeeklyHistoryRow = {
  user_id: string;
  username: string;
  display_name: string | null;
  log_date: string;
  calories_consumed: number | string;
  daily_calorie_goal: number | string | null;
};

type GroupWeeklyHistoryProps = {
  groupId: string;
  refreshToken: number;
  memberId: string;
};

const C = {
  background: "#101010",
  card: "#1A1A1A",
  elevated: "#222222",
  accent: "#B6F36B",
  text: "#FFFFFF",
  secondary: "#999999",
  muted: "#707070",
  border: "#303030",
  goal: "#D8B66A",
  danger: "#FF7777",
};

const getLocalDateString = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}-${month}-${day}`;
};

const getDateLabel = (dateString: string) => {
  // Noon avoids timezone shifts around midnight.
  const date = new Date(`${dateString}T12:00:00`);

  return {
    weekday: date.toLocaleDateString(undefined, {
      weekday: "short",
    }),
    date: date.toLocaleDateString(undefined, {
      day: "numeric",
      month: "short",
    }),
    fullDate: date.toLocaleDateString(undefined, {
      weekday: "long",
      day: "numeric",
      month: "long",
    }),
  };
};

const getCalories = (
  value: number | string | null | undefined
) => {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;
};

const formatCalories = (value: number) =>
  Math.round(value).toLocaleString();

const formatCompactCalories = (value: number) => {
  if (value >= 1000) {
    return `${(value / 1000).toFixed(1)}k`;
  }

  return Math.round(value).toString();
};

export default function GroupWeeklyHistory({
  groupId,
  refreshToken,
  memberId,
}: GroupWeeklyHistoryProps) {
  const [history, setHistory] = useState<WeeklyHistoryRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const loadHistory = useCallback(async () => {
    if (!groupId || !memberId) {
      setHistory([]);
      setLoading(false);
      return;
    }

    setLoading(true);
    setError("");

    try {
      const today = new Date();
      const endDate = getLocalDateString(today);

      const start = new Date(today);
      start.setDate(start.getDate() - 6);
      const startDate = getLocalDateString(start);

      const timezone =
        Intl.DateTimeFormat().resolvedOptions().timeZone ||
        "Asia/Kolkata";

      const { data, error: fetchError } = await supabase.rpc(
        "get_group_weekly_history",
        {
          p_group_id: groupId,
          p_start_date: startDate,
          p_end_date: endDate,
          p_timezone: timezone,
        }
      );

      if (fetchError) throw fetchError;

      const rows = (data ?? []) as WeeklyHistoryRow[];

      setHistory(
        rows
          .filter((row) => row.user_id === memberId)
          .slice()
          .sort((a, b) =>
            a.log_date.localeCompare(b.log_date)
          )
      );
    } catch (err) {
      console.error("Failed to load member weekly history:", err);
      setHistory([]);
      setError(
        "Couldn't load weekly history. Refresh and try again."
      );
    } finally {
      setLoading(false);
    }
  }, [groupId, memberId]);

  useFocusEffect(
    useCallback(() => {
      void loadHistory();
    }, [loadHistory, refreshToken])
  );

  const selectedDays = history;
  const selectedMember = selectedDays[0];

  const totalCalories = selectedDays.reduce(
    (sum, day) =>
      sum + getCalories(day.calories_consumed),
    0
  );

  const averageCalories =
    selectedDays.length > 0
      ? totalCalories / selectedDays.length
      : 0;

  const chartMaximum = Math.max(
    1,
    ...selectedDays.flatMap((day) => [
      getCalories(day.calories_consumed),
      getCalories(day.daily_calorie_goal),
    ])
  );

  const initials = selectedMember
    ? (
        selectedMember.display_name?.trim() ||
        selectedMember.username ||
        "?"
      )
        .charAt(0)
        .toUpperCase()
    : "?";

  const firstDate = selectedDays[0]?.log_date;
  const lastDate = selectedDays[selectedDays.length - 1]?.log_date;

  const dateRange =
    firstDate && lastDate
      ? `${getDateLabel(firstDate).date} – ${getDateLabel(lastDate).date}`
      : "Last 7 days";

  return (
    <View style={styles.section}>
      {/* Section heading */}
      <View style={styles.headingRow}>
        <View style={styles.headingText}>
          <View style={styles.eyebrowRow}>
            <View style={styles.liveDot} />
            <Text style={styles.eyebrow}>GROUP ACTIVITY</Text>
          </View>

          <Text style={styles.sectionTitle}>
            Weekly history
          </Text>

          <Text style={styles.subtitle}>
            {dateRange} · Calories only
          </Text>
        </View>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Refresh weekly history"
          style={({ pressed }) => [
            styles.refreshButton,
            pressed && styles.pressed,
            loading && styles.disabled,
          ]}
          onPress={() => void loadHistory()}
          disabled={loading}
        >
          {loading ? (
            <ActivityIndicator
              color={C.accent}
              size="small"
            />
          ) : (
            <Ionicons
              name="refresh-outline"
              size={19}
              color={C.accent}
            />
          )}
        </Pressable>
      </View>

      {/* Loading state */}
      {loading ? (
        <View style={styles.statusCard}>
          <ActivityIndicator
            color={C.accent}
            size="large"
          />

          <Text style={styles.statusTitle}>
            Loading history
          </Text>

          <Text style={styles.muted}>
            Fetching the latest weekly calorie data.
          </Text>
        </View>
      ) : error ? (
        /* Error state */
        <View style={styles.statusCard}>
          <View style={styles.statusIconError}>
            <Ionicons
              name="alert-circle-outline"
              size={25}
              color={C.danger}
            />
          </View>

          <Text style={styles.statusTitle}>
            Something went wrong
          </Text>

          <Text style={styles.errorText}>{error}</Text>

          <Pressable
            style={styles.retryButton}
            onPress={() => void loadHistory()}
          >
            <Ionicons
              name="refresh-outline"
              size={16}
              color={C.background}
            />

            <Text style={styles.retryText}>
              Try again
            </Text>
          </Pressable>
        </View>
      ) : !selectedMember ? (
        /* Empty state */
        <View style={styles.statusCard}>
          <View style={styles.statusIcon}>
            <Ionicons
              name="bar-chart-outline"
              size={27}
              color={C.accent}
            />
          </View>

          <Text style={styles.statusTitle}>
            No history yet
          </Text>

          <Text style={styles.muted}>
            Weekly calorie history will appear here when data
            is available for this member.
          </Text>

          <Pressable
            style={styles.retryButton}
            onPress={() => void loadHistory()}
          >
            <Ionicons
              name="refresh-outline"
              size={16}
              color={C.background}
            />

            <Text style={styles.retryText}>
              Refresh
            </Text>
          </Pressable>
        </View>
      ) : (
        <>
          {/* Member overview */}
          <View style={styles.summaryCard}>
            <View style={styles.memberRow}>
              <View style={styles.avatar}>
                <Text style={styles.avatarText}>
                  {initials}
                </Text>
              </View>

              <View style={styles.memberInfo}>
                <Text style={styles.summaryName}>
                  {selectedMember.display_name?.trim() ||
                    selectedMember.username}
                </Text>

                <Text style={styles.summaryUsername}>
                  @{selectedMember.username}
                </Text>
              </View>

              <View style={styles.weekBadge}>
                <Ionicons
                  name="calendar-outline"
                  size={12}
                  color={C.accent}
                />

                <Text style={styles.weekBadgeText}>
                  7 DAYS
                </Text>
              </View>
            </View>

            <View style={styles.divider} />

            <View style={styles.summaryStats}>
              <View style={styles.summaryStat}>
                <Text style={styles.statLabel}>
                  TOTAL CONSUMED
                </Text>

                <Text style={styles.statValue}>
                  {formatCalories(totalCalories)}
                </Text>

                <Text style={styles.statUnit}>
                  kcal this week
                </Text>
              </View>

              <View style={styles.statDivider} />

              <View style={styles.summaryStat}>
                <Text style={styles.statLabel}>
                  DAILY AVERAGE
                </Text>

                <Text style={styles.statValue}>
                  {formatCalories(averageCalories)}
                </Text>

                <Text style={styles.statUnit}>
                  kcal per recorded day
                </Text>
              </View>
            </View>
          </View>

          {/* Weekly chart */}
          <View style={styles.chartCard}>
            <View style={styles.chartHeader}>
              <View style={styles.chartHeadingText}>
                <Text style={styles.chartTitle}>
                  Daily calories
                </Text>

                <Text style={styles.chartSubtitle}>
                  Intake compared with daily goal
                </Text>
              </View>

              <View style={styles.chartIcon}>
                <Ionicons
                  name="stats-chart"
                  size={19}
                  color={C.accent}
                />
              </View>
            </View>

            {/* Chart legend */}
            <View style={styles.legendRow}>
              <View style={styles.legendItem}>
                <View style={styles.legendBar} />
                <Text style={styles.legendText}>
                  Consumed
                </Text>
              </View>

              <View style={styles.legendItem}>
                <View style={styles.legendGoalLine} />
                <Text style={styles.legendText}>
                  Daily goal
                </Text>
              </View>
            </View>

            {/* Bar chart */}
            <View style={styles.chart}>
              {selectedDays.map((day) => {
                const calories = getCalories(
                  day.calories_consumed
                );

                const goal =
                  day.daily_calorie_goal == null
                    ? null
                    : getCalories(day.daily_calorie_goal);

                const barHeight =
                  calories > 0
                    ? (calories / chartMaximum) * 100
                    : 3;

                const goalBottom =
                  goal !== null && goal > 0
                    ? (goal / chartMaximum) * 100
                    : null;

                const labels = getDateLabel(day.log_date);

                return (
                  <View
                    key={day.log_date}
                    style={styles.barColumn}
                  >
                    <Text
                      style={styles.barValue}
                      numberOfLines={1}
                    >
                      {formatCompactCalories(calories)}
                    </Text>

                    <View style={styles.barArea}>
                      {goalBottom !== null && (
                        <View
                          style={[
                            styles.goalLine,
                            { bottom: `${goalBottom}%` },
                          ]}
                        />
                      )}

                      <View
                        style={[
                          styles.bar,
                          {
                            height: `${Math.max(
                              3,
                              barHeight
                            )}%`,
                          },
                        ]}
                      />
                    </View>

                    <Text style={styles.weekdayLabel}>
                      {labels.weekday}
                    </Text>

                    <Text style={styles.dateLabel}>
                      {labels.date}
                    </Text>
                  </View>
                );
              })}
            </View>
          </View>

          {/* Daily breakdown */}
          <View style={styles.breakdownCard}>
            <View style={styles.breakdownHeader}>
              <View>
                <Text style={styles.chartTitle}>
                  Daily breakdown
                </Text>

                <Text style={styles.chartSubtitle}>
                  Calorie intake and goal progress
                </Text>
              </View>

              <View style={styles.daysBadge}>
                <Text style={styles.breakdownCount}>
                  {selectedDays.length} DAYS
                </Text>
              </View>
            </View>

            {selectedDays
              .slice()
              .reverse()
              .map((day) => {
                const calories = getCalories(
                  day.calories_consumed
                );

                const goal =
                  day.daily_calorie_goal == null
                    ? null
                    : getCalories(day.daily_calorie_goal);

                const percentage =
                  goal !== null && goal > 0
                    ? Math.round((calories / goal) * 100)
                    : null;

                const labels = getDateLabel(day.log_date);

                const metGoal =
                  percentage !== null && percentage >= 100;

                const progressWidth = `${Math.min(
                  Math.max(percentage ?? 0, 0),
                  100
                )}%` as `${number}%`;

                return (
                  <View
                    key={day.log_date}
                    style={styles.dayRow}
                  >
                    <View style={styles.dayHeader}>
                      <View style={styles.dayInfo}>
                        <Text style={styles.dayName}>
                          {labels.fullDate}
                        </Text>

                        <Text style={styles.dayGoal}>
                          {goal !== null && goal > 0
                            ? `Goal: ${formatCalories(goal)} kcal`
                            : "Daily goal not set"}
                        </Text>
                      </View>

                      <View style={styles.dayTotals}>
                        <Text style={styles.dayCalories}>
                          {formatCalories(calories)}
                        </Text>

                        <Text style={styles.dayKcal}>
                          kcal
                        </Text>
                      </View>
                    </View>

                    {goal !== null && goal > 0 && (
                      <>
                        <View style={styles.dayTrack}>
                          <View
                            style={[
                              styles.dayFill,
                              {
                                width: progressWidth,
                              },
                              metGoal && styles.dayFillMet,
                            ]}
                          />
                        </View>

                        <View style={styles.percentageRow}>
                          <Text style={styles.dayPercentage}>
                            {percentage}% of goal
                          </Text>

                          <View style={styles.goalStatusRow}>
                            <Ionicons
                              name={
                                metGoal
                                  ? "checkmark-circle"
                                  : "time-outline"
                              }
                              size={13}
                              color={
                                metGoal ? C.accent : C.goal
                              }
                            />

                            <Text
                              style={[
                                styles.goalStatus,
                                metGoal && styles.goalStatusMet,
                              ]}
                            >
                              {metGoal
                                ? "Goal reached"
                                : "In progress"}
                            </Text>
                          </View>
                        </View>
                      </>
                    )}
                  </View>
                );
              })}
          </View>

          {/* Privacy note */}
          <View style={styles.privacyNote}>
            <Ionicons
              name="lock-closed-outline"
              size={15}
              color={C.muted}
            />

            <Text style={styles.privacyText}>
              Weekly calorie totals only. Individual food logs
              remain private.
            </Text>
          </View>
        </>
      )}
    </View>
  );
}

