<file path="mobile/src/app/signup.tsx">
import { useRef, useState } from "react";
import type { ComponentRef } from "react";
import {
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { router } from "expo-router";
import BiteLogMark from "../components/BiteLogoMark";

import { supabase } from "../lib/supabase";
import { usePostHog } from "posthog-react-native";
import { Sentry } from "../lib/sentry";
import { useAppDialog } from "../contexts/AppDialogContext";

const C = {
  background: "#101010",
  card: "#1A1A1A",
  input: "#141414",
  accent: "#B6F36B",
  text: "#FFFFFF",
  secondary: "#999999",
  muted: "#707070",
  border: "#303030",
};

export default function SignupScreen() {
  const posthog = usePostHog();
  const { showDialog } = useAppDialog();

  const usernameInputRef = useRef<ComponentRef<typeof TextInput>>(null);
  const passwordInputRef = useRef<ComponentRef<typeof TextInput>>(null);
  const confirmPasswordInputRef = useRef<ComponentRef<typeof TextInput>>(null);

  const [email, setEmail] = useState("");
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [passwordVisible, setPasswordVisible] = useState(false);
  const [confirmPasswordVisible, setConfirmPasswordVisible] = useState(false);
  const [loading, setLoading] = useState(false);

  const handleSignup = async () => {
    const cleanEmail = email.trim().toLowerCase();
    const cleanUsername = username.trim().toLowerCase();

    if (!cleanEmail || !cleanUsername || !password || !confirmPassword) {
      showDialog(
        "Missing information",
        "Please fill in all fields.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (cleanUsername.length < 3) {
      showDialog(
        "Invalid username",
        "Username must be at least 3 characters.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (password.length < 6) {
      showDialog(
        "Invalid password",
        "Password must be at least 6 characters.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (password !== confirmPassword) {
      showDialog(
        "Passwords do not match",
        "Please make sure both passwords are the same.",
        [{ text: "OK" }],
        { type: "warning" },
      );
      return;
    }

    if (loading) return;

    setLoading(true);

    try {
      const { data, error } = await supabase.auth.signUp({
        email: cleanEmail,
        password,
        options: {
          data: {
            username: cleanUsername,
          },
        },
      });

      if (error) {
        Sentry.logger.error("Signup failed", {
          operation: "signup",
          method: "email",
          failure_stage: "supabase_signup",
        });

        Sentry.captureException(error);

        posthog.capture("signup_failed", {
          method: "email",
          failure_stage: "supabase_signup",
        });

        showDialog(
          "Signup failed",
          error.message,
          [{ text: "OK" }],
          { type: "error" },
        );
        return;
      }

      if (!data.user) {
        Sentry.logger.warn("Signup returned no user", {
          operation: "signup",
          reason: "missing_user",
        });

        posthog.capture("signup_failed", {
          method: "email",
          failure_stage: "missing_user",
        });

        showDialog(
          "Signup failed",
          "The account could not be created. Please try again.",
          [{ text: "OK" }],
          { type: "error" },
        );
        return;
      }

      Sentry.logger.info("Signup completed", {
        operation: "signup",
        method: "email",
      });

      posthog.capture("signup_completed", {
        method: "email",
      });

      showDialog(
        "Account created",
        `Welcome, ${cleanUsername}!`,
        [
          {
            text: "Continue",
            onPress: () => router.replace("/"),
          },
        ],
        { type: "success", cancelable: false },
      );
    } catch (error) {
      Sentry.logger.error("Unexpected signup error", {
        operation: "signup",
        method: "email",
        failure_stage: "unexpected_error",
      });

      Sentry.captureException(error);

      posthog.capture("signup_failed", {
        method: "email",
        failure_stage: "unexpected_error",
      });

      showDialog(
        "Something went wrong",
        "We couldn't create your account. Please try again.",
        [{ text: "OK" }],
        { type: "error" },
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.container}
      behavior={Platform.OS === "ios" ? "padding" : "height"}
      keyboardVerticalOffset={0}
    >
      <ScrollView
        contentContainerStyle={styles.content}
        keyboardShouldPersistTaps="handled"
        keyboardDismissMode={Platform.OS === "ios" ? "interactive" : "on-drag"}
        showsVerticalScrollIndicator={false}
      >
        {/* Brand */}
        <View style={styles.brand}>
          <View style={styles.brandIcon}>
            <BiteLogMark width={52} height={52} />
          </View>

          <Text style={styles.brandName}>
            Bite<Text style={styles.brandAccent}>Log</Text>
          </Text>
        </View>

        {/* Heading */}
        <View style={styles.header}>
          <Text style={styles.eyebrow}>YOUR JOURNEY STARTS HERE</Text>

          <Text style={styles.title}>
            Create your{"\n"}account.
          </Text>

          <Text style={styles.subtitle}>
            Join BiteLog and take control of your daily nutrition, one meal
            at a time.
          </Text>
        </View>

        <View style={styles.form}>
          {/* Email */}
          <Text style={styles.label}>Email address</Text>

          <View style={styles.inputContainer}>
            <Ionicons name="mail-outline" size={19} color={C.muted} />

            <TextInput
              style={styles.input}
              placeholder="you@example.com"
              placeholderTextColor={C.muted}
              value={email}
              onChangeText={setEmail}
              autoCapitalize="none"
              autoCorrect={false}
              keyboardType="email-address"
              textContentType="emailAddress"
              autoComplete="email"
              editable={!loading}
              returnKeyType="next"
              onSubmitEditing={() => usernameInputRef.current?.focus()}
              blurOnSubmit={false}
            />
          </View>

          {/* Username */}
          <Text style={styles.label}>Username</Text>

          <View style={styles.inputContainer}>
            <Ionicons name="at-outline" size={19} color={C.muted} />

            <TextInput
              ref={usernameInputRef}
              style={styles.input}
              placeholder="Choose a username"
              placeholderTextColor={C.muted}
              value={username}
              onChangeText={setUsername}
              autoCapitalize="none"
              autoCorrect={false}
              textContentType="username"
              autoComplete="username-new"
              editable={!loading}
              returnKeyType="next"
              onSubmitEditing={() => passwordInputRef.current?.focus()}
              blurOnSubmit={false}
            />
          </View>

          <View style={styles.helperContainer}>
            <Ionicons name="people-outline" size={14} color={C.accent} />

            <Text style={styles.helper}>
              This is the name your friends will see.
            </Text>
          </View>

          {/* Password */}
          <Text style={styles.label}>Password</Text>

          <View style={styles.inputContainer}>
            <Ionicons name="lock-closed-outline" size={19} color={C.muted} />

            <TextInput
              ref={passwordInputRef}
              style={styles.input}
              placeholder="Create a password"
              placeholderTextColor={C.muted}
              value={password}
              onChangeText={setPassword}
              secureTextEntry={!passwordVisible}
              autoCapitalize="none"
              autoCorrect={false}
              textContentType="newPassword"
              autoComplete="new-password"
              editable={!loading}
              returnKeyType="next"
              onSubmitEditing={() => confirmPasswordInputRef.current?.focus()}
              blurOnSubmit={false}
            />

            <Pressable
              onPress={() => setPasswordVisible((visible) => !visible)}
              disabled={loading}
              hitSlop={10}
              accessibilityRole="button"
              accessibilityLabel={passwordVisible ? "Hide password" : "Show password"}
            >
              <Ionicons
                name={passwordVisible ? "eye-off-outline" : "eye-outline"}
                size={20}
                color={C.muted}
              />
            </Pressable>
          </View>

          <Text style={styles.passwordHint}>Use at least 6 characters.</Text>

          {/* Confirm password */}
          <Text style={styles.label}>Confirm password</Text>

          <View style={styles.inputContainer}>
            <Ionicons
              name="shield-checkmark-outline"
              size={19}
              color={C.muted}
            />

            <TextInput
              ref={confirmPasswordInputRef}
              style={styles.input}
              placeholder="Enter password again"
              placeholderTextColor={C.muted}
              value={confirmPassword}
              onChangeText={setConfirmPassword}
              secureTextEntry={!confirmPasswordVisible}
              autoCapitalize="none"
              autoCorrect={false}
              textContentType="newPassword"
              autoComplete="new-password"
              editable={!loading}
              onSubmitEditing={handleSignup}
              returnKeyType="done"
            />

            <Pressable
              onPress={() =>
                setConfirmPasswordVisible((visible) => !visible)
              }
              disabled={loading}
              hitSlop={10}
              accessibilityRole="button"
              accessibilityLabel={
                confirmPasswordVisible ? "Hide password" : "Show password"
              }
            >
              <Ionicons
                name={
                  confirmPasswordVisible ? "eye-off-outline" : "eye-outline"
                }
                size={20}
                color={C.muted}
              />
            </Pressable>
          </View>

          {/* Create account */}
          <Pressable
            style={({ pressed }) => [
              styles.button,
              pressed && styles.buttonPressed,
              loading && styles.buttonDisabled,
            ]}
            onPress={handleSignup}
            disabled={loading}
          >
            {loading ? (
              <ActivityIndicator color={C.background} />
            ) : (
              <>
                <Text style={styles.buttonText}>Create account</Text>

                <Ionicons name="arrow-forward" size={19} color={C.background} />
              </>
            )}
          </Pressable>

          {/* Login */}
          <Pressable
            style={styles.loginContainer}
            onPress={() => router.back()}
            disabled={loading}
          >
            <Text style={styles.loginText}>Already have an account? </Text>

            <Text style={styles.loginLink}>Log in</Text>
          </Pressable>

          {/* Footer */}
          <View style={styles.footer}>
            <Ionicons
              name="shield-checkmark-outline"
              size={14}
              color={C.muted}
            />

            <Text style={styles.footerText}>
              Your information stays private.
            </Text>
          </View>
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

